# ==============================================================================
# Environment Configuration Template (.env)
# ==============================================================================
# Copy this file to '.env' and fill in your personal developer credentials.
# NEVER commit your actual '.env' file or API keys to version control!

# Kaggle API Credentials (obtain from https://www.kaggle.com/settings -> Create New Token)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional: Default Compute Tier Preference (kaggle | colab | gpu | cpu | auto)
DEFAULT_COMPUTE_TIER=auto

# Optional: Local Run Directory Override
TQC_RUN_DIR=runs
